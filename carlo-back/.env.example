# Runtime only. Keep maintenance credentials in a separate ignored .env.maintenance file.
# Render uses supabase; local development uses local.
DATABASE_PROVIDER=local
# Supabase: acutis_app role, exact project/session host, port 5432, schema=acutis,
# sslmode=require&sslaccept=strict. Never use the postgres maintenance role here.
DATABASE_URL=
JWT_SECRET=
ADMIN_KEY=
FRONTEND_ORIGIN=http://localhost:3000
PORT=4100
HOST=127.0.0.1
NODE_ENV=development
DB_CONNECTION_LIMIT=5
TRUST_PROXY_HOPS=0
# Required only if trust is enabled: exact verified proxy peer IPs, never client-supplied headers.
TRUSTED_PROXY_ADDRESSES=
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=25000
AI_MAX_CONCURRENCY=2
AI_DAILY_REQUEST_LIMIT=100
