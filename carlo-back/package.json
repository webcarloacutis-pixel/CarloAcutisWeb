{
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "prisma generate && esbuild src/server.ts --bundle --packages=external --platform=node --target=node24 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -n build,server \"npm run dev:build\" \"node --watch dist/server.js\"",
    "dev:build": "esbuild src/server.ts --bundle --packages=external --platform=node --target=node24 --outfile=dist/server.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma.config.ts",
    "db:migrate": "prisma migrate deploy",
    "popularity": "tsx src/scripts/generate-popularity.ts",
    "maintenance:cleanup": "tsx src/scripts/cleanup-expired.ts",
    "maintenance:birthplaces": "tsx src/scripts/apply-birthplaces.ts",
    "catalog:import": "tsx src/scripts/import-catalog.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.15.0",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24.13.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.5",
    "@types/jsonwebtoken": "9.0.10"
  }
}
