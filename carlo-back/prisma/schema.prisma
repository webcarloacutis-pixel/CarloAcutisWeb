generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Saint {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  country   String?

  title     String?
  feastDay  String?
  imageUrl  String?
  biography String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  miracles      Miracle[]
  translations  SaintTranslation[]
  continent String?
  lat       Float?
  lng       Float?
  birthYear       Int?
  canonizationYear Int?
  patronOf String[] @default([])
  symbols String[] @default([])
  editorial Json?
  catalogImport CatalogImport?
  deathYear       Int?
  birthCountryCode String?
  birthContinent String?
  birthPlace String?
  birthLat Float?
  birthLng Float?
  birthPrecision String?
  birthSources Json?

  @@index([birthContinent, birthCountryCode])
  @@index([deathYear])

}


model Miracle {
  id        String   @id @default(cuid())
  saintId   String
  title     String
  type      String?  // ej: "Curación", "Eucarístico", "Aparición"
  date      String?  // por ahora string (luego lo pasamos a Date si quieres)
  location  String?
  witnesses String?
  approved  Boolean  @default(false)
  details   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saint     Saint    @relation(fields: [saintId], references: [id], onDelete: Cascade)

  translations MiracleTranslation[]

  @@index([saintId])
}

model Prayer {
  translations PrayerTranslation[]

  id        String   @id @default(cuid())
  title     String
  content   String
  category  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saintName String?
  occasion  String?
  @@index([approved, id])
}



model SaintTranslation {
  id        String  @id @default(cuid())
  saintId   String
  lang      String  // "es" | "en" | "hi" ...

  name      String?
  title     String?
  biography String? @db.Text

  saint     Saint   @relation(fields: [saintId], references: [id], onDelete: Cascade)

  @@unique([saintId, lang], name: "saintId_lang")
  @@index([lang])
}

model MiracleTranslation {
  id        String  @id @default(cuid())
  miracleId String
  lang      String

  title     String?
  type      String?
  date      String?
  location  String?
  witnesses String?
  details   String?

  miracle   Miracle @relation(fields: [miracleId], references: [id], onDelete: Cascade)

  @@unique([miracleId, lang], name: "miracleId_lang")
  @@index([lang])
}

model PrayerTranslation {
  id       String @id @default(cuid())
  prayerId String
  lang     String

  title    String?
  content  String?
  category String?
  saintName String?
  occasion  String?


  prayer   Prayer @relation(fields: [prayerId], references: [id], onDelete: Cascade)

  @@unique([prayerId, lang], name: "prayerId_lang")
  @@index([lang])
}

////////////////////////////////////////////////////////////
// USERS + CHAT (SQL)
////////////////////////////////////////////////////////////
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations Conversation[]
  sessions AuthSession[]
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  @@index([userId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt, id])
}

model ApiQuota {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}
model AiLease {
  id String @id
  owner String?
  expiresAt DateTime
}
model TranslationCache {
  id String @id
  translated String @db.Text
  model String
  targetLang String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}
model PopularityEstimate {
  id String @id @default(cuid())
  contentType String
  contentId String
  score Int?
  generatedAt DateTime?
  model String?
  methodologyVersion String?
  inputHash String?
  leaseUntil DateTime?
  leaseOwner String?
  @@unique([contentType, contentId])
}

model AuthSession {
  id String @id @default(cuid())
  userId String?
  kind String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model AiRequest {
  id String @id
  inputHash String
  response String? @db.Text
  model String?
  leaseOwner String
  leaseUntil DateTime
  expiresAt DateTime
  @@index([expiresAt])
}

// Internal import provenance; never accepted as an admin/public payload.
model CatalogImport {
  identityKey String @id
  saintId String? @unique
  importedHash String
  snapshot Json
  importedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  saint Saint? @relation(fields: [saintId], references: [id], onDelete: SetNull)
}
