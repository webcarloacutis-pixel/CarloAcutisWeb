# Browser calls always use this frontend origin. No public backend/admin/provider keys.
BACKEND_URL=http://127.0.0.1:4100
# Render supplies BACKEND_HOSTPORT instead of BACKEND_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FORWARD_TRUSTED_IP=false
NEXT_PUBLIC_MAP_TILES_ENABLED=false
# Enable only with an approved map tile provider. This build-time option requires rebuild.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ANALYTICS_ENABLED=false
UMAMI_WEBSITE_ID=
UMAMI_COLLECTOR_URL=
UMAMI_ALLOWED_HOSTS=
NEXT_TELEMETRY_DISABLED=1

# Build-time setting. Render uses supabase after the verified Storage transfer.
CATALOG_STORAGE_PROVIDER=local
